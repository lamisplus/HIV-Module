    <!-- Convert noted_side_effect from TEXT to JSONB for multi-select support -->
    <changeSet id="20260417-art-clinical-01" author="taiwo-dev" failOnError="false">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_art_clinical"/>
            <columnExists tableName="hiv_art_clinical" columnName="noted_side_effect"/>
        </preConditions>

        <sql dbms="postgresql">
            -- First, backup any existing text data by converting to JSON array
            -- If the column has text data, wrap it in a JSON array with a single element
            UPDATE hiv_art_clinical
            SET noted_side_effect = CASE
                WHEN noted_side_effect IS NOT NULL AND noted_side_effect != '' AND noted_side_effect !~ '^\[.*\]$'
                THEN ('["' || noted_side_effect || '"]')::text
                ELSE noted_side_effect
            END
            WHERE noted_side_effect IS NOT NULL AND noted_side_effect != '';

            -- Change column type from TEXT to JSONB
            ALTER TABLE hiv_art_clinical
            ALTER COLUMN noted_side_effect TYPE JSONB USING noted_side_effect::jsonb;

            -- Create GIN index for better JSONB query performance
            CREATE INDEX IF NOT EXISTS idx_art_clinical_noted_side_effect
            ON hiv_art_clinical USING GIN(noted_side_effect)
            WHERE noted_side_effect IS NOT NULL;

            -- Update comment
            COMMENT ON COLUMN hiv_art_clinical.noted_side_effect IS 'JSON array of side effect codes from PREP_SIDE_EFFECTS codeset';
        </sql>

        <rollback>
            <sql>
                DROP INDEX IF EXISTS idx_art_clinical_noted_side_effect;
                ALTER TABLE hiv_art_clinical ALTER COLUMN noted_side_effect TYPE TEXT;
            </sql>
        </rollback>
    </changeSet>

