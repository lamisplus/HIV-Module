<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <property name="autoIncrement" value="true"/>
    <!-- Create hiv_enrollment_commencement table                                -->
    <changeSet id="20250219-ec-01" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hiv_enrollment_commencement"/>
            </not>
        </preConditions>

        <createTable tableName="hiv_enrollment_commencement">
            <!-- ── Infrastructure ────────────────────────────────────────── -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="unique_id" type="VARCHAR(100)"/>
            <column name="facility_id" type="BIGINT"/>
            <column name="person_uuid" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_ec_person_uuid"
                             references="patient_person(uuid)"/>
            </column>
            <column name="visit_id" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_ec_visit"
                             references="patient_visit(uuid)"/>
            </column>
            <column name="vital_sign_uuid" type="VARCHAR(255)">
                <constraints foreignKeyName="fk_ec_vital_sign"
                             references="triage_vital_sign(uuid)"/>
            </column>
            <column name="is_commencement" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="art_status_id" type="BIGINT"/>
            <column name="status_at_registration_id" type="BIGINT"/>
            <column name="source" type="VARCHAR(255)"/>
            <column name="latitude" type="VARCHAR(255)"/>
            <column name="longitude" type="VARCHAR(255)"/>
            <column name="archived" type="INTEGER" defaultValueNumeric="0"/>
            <!-- ── Audit ──────────────────────────────────────────────────── -->
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="last_modified_date" type="TIMESTAMP"/>
            <!-- ── Registration — HIV Care & Identification ───────────────── -->
            <column name="date_enrolled_in_hiv_care" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_confirmed_hiv_test" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="hiv_test_location" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="mode_of_hiv_test_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="care_entry_point_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="care_entry_point_other" type="VARCHAR(255)"/>
            <!-- mother_unique_id: Required ONLY if age < 18 months (infant) - validated in backend -->
            <column name="mother_unique_id" type="VARCHAR(100)"/>
            <!-- ── Registration — Prior ART & KP ─────────────────────────── -->
            <column name="prior_art_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="is_kp" type="BOOLEAN" defaultValueBoolean="false"/>
            <!-- kp_typology_id: Required ONLY if is_kp = TRUE - validated in backend -->
            <column name="kp_typology_id" type="VARCHAR(255)"/>

            <!-- ── Registration — Transfer Details ───────────────────────── -->
            <!-- date_transferred_in: Required ONLY if care_entry_point = "Transfer In" - validated in backend -->
            <!-- facility_transferred_from: Required ONLY if date_transferred_in is provided - validated in backend -->
            <column name="date_transferred_in" type="DATE"/>
            <column name="facility_transferred_from" type="VARCHAR(255)"/>

            <!-- ── Commencement — Clinical Status ─────────────────────────── -->
            <column name="clinical_stage_id" type="VARCHAR(255)"/>
            <column name="cd4_at_art_start" type="BIGINT"/>
            <column name="cd4_percentage" type="DOUBLE"/>
            <column name="cd4_lf_id" type="VARCHAR(255)"/>

            <!-- ── Commencement — ART Dates & Regimen ─────────────────────── -->
            <column name="date_adherence_counseling_completed" type="DATE"/>
            <column name="date_art_started" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="regimen_line_id" type="VARCHAR(255)"/>
            <column name="regimen_id" type="VARCHAR(255)"/>

            <!-- ── Commencement — Vitals ──────────────────────────────────── -->
            <column name="weight_kg" type="DOUBLE"/>
            <column name="height_cm" type="DOUBLE"/>
            <column name="bmi" type="DOUBLE"/>
            <column name="muac" type="DOUBLE"/>
            <column name="muac_indication" type="VARCHAR(50)"/>
            <column name="is_pregnant" type="BOOLEAN"/>
            <column name="pregnancy_status" type="VARCHAR(50)"/>

            <!-- ── Commencement — TB Preventive Therapy ───────────────────── -->
            <column name="tpt_medication" type="BIGINT"/>
            <column name="tpt_dose" type="VARCHAR(100)"/>
            <column name="tpt_start_date" type="DATE"/>
            <column name="tpt_completed" type="VARCHAR(50)"/>
            <column name="tpt_completion_date" type="DATE"/>

        </createTable>
    </changeSet>

    <!-- Indexes                                                                -->
    <changeSet id="20250219-ec-02" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_enrollment_commencement"/>
        </preConditions>

        <createIndex indexName="idx_ec_person_uuid"
                     tableName="hiv_enrollment_commencement">
            <column name="person_uuid"/>
            <column name="archived"/>
        </createIndex>

        <createIndex indexName="idx_ec_unique_id"
                     tableName="hiv_enrollment_commencement">
            <column name="unique_id"/>
        </createIndex>

        <createIndex indexName="idx_ec_mother_unique_id"
                     tableName="hiv_enrollment_commencement">
            <column name="mother_unique_id"/>
        </createIndex>
    </changeSet>

    <!-- Unique constraint to ensure one active record per person               -->
    <changeSet id="20250220-ec-03" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_enrollment_commencement"/>
            <not>
                <indexExists tableName="hiv_enrollment_commencement" indexName="uk_ec_person_active"/>
            </not>
        </preConditions>

        <sql>
            CREATE UNIQUE INDEX uk_ec_person_active
            ON hiv_enrollment_commencement (person_uuid)
            WHERE archived = 0;
        </sql>

        <rollback>
            <sql>
                DROP INDEX IF EXISTS uk_ec_person_active;
            </sql>
        </rollback>
    </changeSet>

    <!-- Add enrollment_commencement_uuid column to hiv_art_clinical table     -->
    <changeSet id="20250330-ec-04" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_art_clinical"/>
            <not>
                <columnExists tableName="hiv_art_clinical" columnName="enrollment_commencement_uuid"/>
            </not>
        </preConditions>

        <addColumn tableName="hiv_art_clinical">
            <column name="enrollment_commencement_uuid" type="VARCHAR(255)">
                <constraints nullable="true"
                             foreignKeyName="fk_art_clinical_enrollment_commencement"
                             references="hiv_enrollment_commencement(uuid)"/>
            </column>
        </addColumn>

        <createIndex indexName="idx_art_clinical_enrollment_commencement"
                     tableName="hiv_art_clinical">
            <column name="enrollment_commencement_uuid"/>
        </createIndex>
    </changeSet>

    <!-- Make hiv_art_clinical columns nullable for backward compatibility     -->
    <changeSet id="20250330-ec-05" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_art_clinical"/>
        </preConditions>

        <!-- Make hiv_enrollment_uuid nullable (new records use enrollment_commencement_uuid instead) -->
        <dropNotNullConstraint tableName="hiv_art_clinical"
                               columnName="hiv_enrollment_uuid"
                               columnDataType="VARCHAR(255)"/>

        <!-- Make visit_id nullable (can be null if visit creation fails) -->
        <dropNotNullConstraint tableName="hiv_art_clinical"
                               columnName="visit_id"
                               columnDataType="VARCHAR(255)"/>
    </changeSet>

    <!-- Add visit_date column to hiv_enrollment_commencement table          -->
    <changeSet id="20250401-ec-06" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_enrollment_commencement"/>
            <not>
                <columnExists tableName="hiv_enrollment_commencement" columnName="visit_date"/>
            </not>
        </preConditions>

        <addColumn tableName="hiv_enrollment_commencement">
            <column name="visit_date" type="DATE">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="hiv_enrollment_commencement" columnName="visit_date"/>
        </rollback>
    </changeSet>

    <!-- Create hiv_initial_clinical_evaluation table                         -->
    <changeSet id="20250401-ice-01" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hiv_initial_clinical_evaluation"/>
            </not>
        </preConditions>

        <createTable tableName="hiv_initial_clinical_evaluation">
            <!-- ── Primary key and audit fields ────────────────────────────── -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="last_modified_date" type="TIMESTAMP"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>

            <!-- ── Core identification fields ──────────────────────────────── -->
            <column name="facility_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_hiv_ice_facility"
                             references="base_organisation_unit(id)"/>
            </column>
            <column name="person_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_hiv_ice_person"
                             references="patient_person(id)"/>
            </column>
            <column name="visit_id" type="BIGINT">
                <constraints foreignKeyName="fk_hiv_ice_visit"
                             references="patient_visit(id)"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="archived" type="INTEGER" defaultValueNumeric="0"/>

            <!-- ── Basic ICE fields ────────────────────────────────────────── -->
            <column name="visit_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="clinician_name" type="VARCHAR(255)"/>

            <!-- ── Regimen fields (structured columns) ───── -->
            <column name="regimen_line_id" type="VARCHAR(255)"/>
            <column name="regimen_id" type="VARCHAR(255)"/>

            <!-- ── WHO Staging ──────────────────────────────────────────────── -->
            <column name="who_stage_id" type="BIGINT">
                <constraints foreignKeyName="fk_hiv_ice_who_stage"
                             references="base_application_codeset(id)"/>
            </column>

            <!-- ── Complex nested data stored as JSONB ─────────────────────── -->
            <column name="symptoms" type="JSONB"/>
            <column name="other_symptom" type="VARCHAR(500)"/>
            <column name="tb_assessment" type="JSONB"/>
            <column name="known_drug_allergies" type="JSONB"/>
            <column name="pregnancy" type="JSONB"/>
            <column name="current_medications" type="JSONB"/>
            <column name="disclosure" type="JSONB"/>
            <column name="disclosure_other_text" type="VARCHAR(500)"/>
            <column name="arv_side_effects" type="JSONB"/>
            <column name="arv_history" type="JSONB"/>
            <column name="vitals" type="JSONB"/>
            <column name="physical_exam" type="JSONB"/>
            <column name="assessment" type="JSONB"/>
            <column name="next_appointment" type="DATE"/>

            <!-- ── Geolocation and metadata ────────────────────────────────── -->
            <column name="source" type="VARCHAR(255)"/>
            <column name="latitude" type="VARCHAR(255)"/>
            <column name="longitude" type="VARCHAR(255)"/>
            <column name="comment" type="TEXT"/>
        </createTable>
    </changeSet>

    <!-- Create indexes for hiv_initial_clinical_evaluation                   -->
    <changeSet id="20250401-ice-02" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_initial_clinical_evaluation"/>
        </preConditions>

        <createIndex indexName="idx_hiv_ice_person"
                     tableName="hiv_initial_clinical_evaluation">
            <column name="person_id"/>
        </createIndex>

        <createIndex indexName="idx_hiv_ice_facility"
                     tableName="hiv_initial_clinical_evaluation">
            <column name="facility_id"/>
        </createIndex>

        <createIndex indexName="idx_hiv_ice_archived"
                     tableName="hiv_initial_clinical_evaluation">
            <column name="archived"/>
        </createIndex>

        <createIndex indexName="idx_hiv_ice_visit_date"
                     tableName="hiv_initial_clinical_evaluation">
            <column name="visit_date"/>
        </createIndex>

        <createIndex indexName="idx_hiv_ice_regimen_line"
                     tableName="hiv_initial_clinical_evaluation">
            <column name="regimen_line_id"/>
        </createIndex>

        <createIndex indexName="idx_hiv_ice_regimen"
                     tableName="hiv_initial_clinical_evaluation">
            <column name="regimen_id"/>
        </createIndex>

        <createIndex indexName="idx_hiv_ice_uuid"
                     tableName="hiv_initial_clinical_evaluation">
            <column name="uuid"/>
        </createIndex>
    </changeSet>

    <!-- Unique constraint to ensure one ICE record per person per facility   -->
    <changeSet id="20250401-ice-03" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_initial_clinical_evaluation"/>
            <not>
                <indexExists tableName="hiv_initial_clinical_evaluation" indexName="uk_ice_person_facility_active"/>
            </not>
        </preConditions>

        <sql>
            CREATE UNIQUE INDEX uk_ice_person_facility_active
            ON hiv_initial_clinical_evaluation (person_id, facility_id)
            WHERE archived = 0;
        </sql>

        <rollback>
            <sql>
                DROP INDEX IF EXISTS uk_ice_person_facility_active;
            </sql>
        </rollback>
    </changeSet>

    <!-- Add person_uuid column to hiv_initial_clinical_evaluation table      -->
    <changeSet id="20260402-ice-04" author="taiwo-dev" failOnError="false">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_initial_clinical_evaluation"/>
            <not>
                <columnExists tableName="hiv_initial_clinical_evaluation" columnName="person_uuid"/>
            </not>
        </preConditions>

        <sql dbms="postgresql">
            -- Add person_uuid column to hiv_initial_clinical_evaluation table
            ALTER TABLE hiv_initial_clinical_evaluation ADD COLUMN IF NOT EXISTS person_uuid VARCHAR(255);

            -- Populate person_uuid from person table based on person_id
            UPDATE hiv_initial_clinical_evaluation ice
            SET person_uuid = p.uuid
            FROM patient_person p
            WHERE ice.person_id = p.id
            AND ice.person_uuid IS NULL;

            -- Add index for better query performance
            CREATE INDEX IF NOT EXISTS idx_ice_person_uuid ON hiv_initial_clinical_evaluation(person_uuid);

            -- Add comment
            COMMENT ON COLUMN hiv_initial_clinical_evaluation.person_uuid IS 'Person UUID from patient_person table';
        </sql>

        <rollback>
            <sql>
                DROP INDEX IF EXISTS idx_ice_person_uuid;
                ALTER TABLE hiv_initial_clinical_evaluation DROP COLUMN IF EXISTS person_uuid;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="20260404-combined-updates-01" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="hiv_initial_clinical_evaluation"/>
            <tableExists tableName="hiv_enrollment_commencement"/>
        </preConditions>

        <addColumn tableName="hiv_initial_clinical_evaluation">
            <column name="transfer_in" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <dropColumn tableName="hiv_enrollment_commencement" columnName="art_status_id"/>

        <rollback>
            <dropColumn tableName="hiv_initial_clinical_evaluation" columnName="transfer_in"/>
            <addColumn tableName="hiv_enrollment_commencement">
                <column name="art_status_id" type="BIGINT"/>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
