<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <property name="autoIncrement" value="true"/>
    <!-- Create hiv_enrollment_commencement table                                -->
    <changeSet id="20250219-ec-01" author="taiwo-dev" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hiv_enrollment_commencement"/>
            </not>
        </preConditions>

        <createTable tableName="hiv_enrollment_commencement">
            <!-- ── Infrastructure ────────────────────────────────────────── -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="unique_id" type="VARCHAR(100)"/>
            <column name="facility_id" type="BIGINT"/>
            <column name="person_uuid" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_ec_person_uuid"
                             references="patient_person(uuid)"/>
            </column>
            <column name="visit_id" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_ec_visit"
                             references="patient_visit(uuid)"/>
            </column>
            <column name="vital_sign_uuid" type="VARCHAR(255)">
                <constraints foreignKeyName="fk_ec_vital_sign"
                             references="triage_vital_sign(uuid)"/>
            </column>
            <column name="is_commencement" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="art_status_id" type="BIGINT"/>
            <column name="status_at_registration_id" type="BIGINT"/>
            <column name="source" type="VARCHAR(255)"/>
            <column name="latitude" type="VARCHAR(255)"/>
            <column name="longitude" type="VARCHAR(255)"/>
            <column name="archived" type="INTEGER" defaultValueNumeric="0"/>
            <!-- ── Audit ──────────────────────────────────────────────────── -->
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="last_modified_date" type="TIMESTAMP"/>
            <!-- ── Registration — HIV Care & Identification ───────────────── -->
            <column name="date_enrolled_in_hiv_care" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_confirmed_hiv_test" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="hiv_test_location" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="mode_of_hiv_test_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="care_entry_point_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="care_entry_point_other" type="VARCHAR(255)"/>
            <!-- mother_unique_id: Required ONLY if age < 18 months (infant) - validated in backend -->
            <column name="mother_unique_id" type="VARCHAR(100)"/>
            <!-- ── Registration — Prior ART & KP ─────────────────────────── -->
            <column name="prior_art_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="is_kp" type="BOOLEAN" defaultValueBoolean="false"/>
            <!-- kp_typology_id: Required ONLY if is_kp = TRUE - validated in backend -->
            <column name="kp_typology_id" type="VARCHAR(255)"/>

            <!-- ── Registration — Transfer Details ───────────────────────── -->
            <!-- date_transferred_in: Required ONLY if care_entry_point = "Transfer In" - validated in backend -->
            <!-- facility_transferred_from: Required ONLY if date_transferred_in is provided - validated in backend -->
            <column name="date_transferred_in" type="DATE"/>
            <column name="facility_transferred_from" type="VARCHAR(255)"/>

            <!-- ── Commencement — Clinical Status ─────────────────────────── -->
            <column name="clinical_stage_id" type="VARCHAR(255)"/>
            <column name="cd4_at_art_start" type="BIGINT"/>
            <column name="cd4_percentage" type="DOUBLE"/>
            <column name="cd4_lf_id" type="VARCHAR(255)"/>

            <!-- ── Commencement — ART Dates & Regimen ─────────────────────── -->
            <column name="date_adherence_counseling_completed" type="DATE"/>
            <column name="date_art_started" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="regimen_line_id" type="VARCHAR(255)"/>
            <column name="regimen_id" type="VARCHAR(255)"/>

            <!-- ── Commencement — Vitals ──────────────────────────────────── -->
            <column name="weight_kg" type="DOUBLE"/>
            <column name="height_cm" type="DOUBLE"/>
            <column name="bmi" type="DOUBLE"/>
            <column name="muac" type="DOUBLE"/>
            <column name="muac_indication" type="VARCHAR(50)"/>
            <column name="is_pregnant" type="BOOLEAN"/>
            <column name="pregnancy_status" type="VARCHAR(50)"/>

            <!-- ── Commencement — TB Preventive Therapy ───────────────────── -->
            <column name="tpt_medication" type="BIGINT"/>
            <column name="tpt_dose" type="VARCHAR(100)"/>
            <column name="tpt_start_date" type="DATE"/>
            <column name="tpt_completed" type="VARCHAR(50)"/>
            <column name="tpt_completion_date" type="DATE"/>

        </createTable>
    </changeSet>

