<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="optimize-viral-load-indexes-001" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_patient_person_facility_archived"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_patient_person_facility_archived" tableName="patient_person">
            <column name="facility_id"/>
            <column name="archived"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_patient_person_facility_archived" tableName="patient_person"/>
        </rollback>
    </changeSet>

